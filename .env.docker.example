# Settings for docker compose (copy to .env.docker). See apps/api/.env.example for every option.
NODE_ENV=production
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-64-random-hex-characters-replace-with-64-random-hex
SEED_ADMIN_EMAIL=admin@ghotok.com.bd
SEED_ADMIN_PASSWORD=replace-me-with-a-strong-password

# Production refuses SMS_DRIVER=log. Configure your SMS gateway:
SMS_DRIVER=http
SMS_HTTP_URL=https://sms.example.com/send?api_key={apiKey}&to={to}&sender={senderId}&message={message}
SMS_API_KEY=
SMS_SENDER_ID=

BKASH_MERCHANT_NUMBER=
NAGAD_MERCHANT_NUMBER=
ROCKET_MERCHANT_NUMBER=
SUPPORT_EMAIL=support@ghotok.com.bd
