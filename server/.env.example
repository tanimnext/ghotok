NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ghotok

# Long random string. Required in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API (web + admin), comma separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000

# Manual payment numbers shown to users (Send Money / Payment)
BKASH_MERCHANT_NUMBER=01XXXXXXXXX
NAGAD_MERCHANT_NUMBER=01XXXXXXXXX
ROCKET_MERCHANT_NUMBER=01XXXXXXXXXX

# bKash Tokenized Checkout (optional). Turn on once you have merchant credentials.
BKASH_API_ENABLED=false
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# File storage: local (./uploads) or r2 (Cloudflare R2)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Email for password reset (optional; logs to console when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ghotok <no-reply@ghotok.com.bd>

# First super admin created by `npm run seed`
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@ghotok.com.bd
SEED_ADMIN_PASSWORD=ChangeMe!2026
