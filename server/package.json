{
  "name": "ghotok-server",
  "version": "1.0.0",
  "private": true,
  "description": "Ghotok REST API — Express + MongoDB",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
