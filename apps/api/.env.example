# Ghotok API configuration. Copy to .env and adjust. Every variable is validated at
# start-up (src/config/env.js); production refuses unsafe values.

NODE_ENV=development
PORT=5000
# fatal | error | warn | info | debug | trace | silent (default: debug in dev, info in prod)
LOG_LEVEL=
MONGODB_URI=mongodb://127.0.0.1:27017/ghotok

# Long random string (at least 32 characters in production): openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API (web + admin), comma separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Public URLs used in emails, redirects and the API docs
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000
# Number of reverse proxies in front of the API (for correct client IPs and rate limits)
TRUST_PROXY=1

# Default manual payment numbers (a super admin can change them in Admin › Settings)
BKASH_MERCHANT_NUMBER=
NAGAD_MERCHANT_NUMBER=
# Rocket account numbers have 12 digits (mobile number + check digit)
ROCKET_MERCHANT_NUMBER=

# bKash Tokenized Checkout (optional). Turn on once you have merchant credentials.
BKASH_API_ENABLED=false
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Google sign-in: OAuth 2.0 Web client ID from Google Cloud console (empty = disabled)
GOOGLE_CLIENT_ID=

# SMS for one-time codes.
#   log  = development only: codes are written to the server log
#   http = any Bangladeshi SMS gateway; placeholders {to} {message} {senderId} {apiKey}
SMS_DRIVER=log
SMS_HTTP_URL=
SMS_HTTP_METHOD=GET
# For POST gateways, a JSON body template, e.g. {"to":"{to}","msg":"{message}","sid":"{senderId}"}
SMS_HTTP_BODY=
SMS_SENDER_ID=
SMS_API_KEY=

# File storage: local (./uploads) or r2 (Cloudflare R2, recommended in production)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Email (verification, password reset, notifications). Empty SMTP_HOST = log only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ghotok <no-reply@ghotok.com.bd>"
# Receives messages from the public contact form
SUPPORT_EMAIL=support@ghotok.com.bd

# First super admin created by `npm run seed` (change the password before production)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@ghotok.com.bd
SEED_ADMIN_PASSWORD=ChangeMe!2026
